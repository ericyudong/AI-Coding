# E-Claw Environment Configuration
# Copy this file to .env and modify the values

# Application Settings
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://eclaw:eclaw@localhost:5432/eclaw

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production

# Multi-tenant Settings
DEFAULT_TENANT_QUOTA=1000000
MAX_TENANTS=100

# Task Configuration
MAX_FILE_SIZE=104857600
MAX_TASK_INPUT_LENGTH=4000

# Checkpoint Configuration
CHECKPOINT_INTERVAL=1
CHECKPOINT_DIR=/var/lib/e-claw/checkpoints

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
VECTOR_DB_PATH=/var/lib/e-claw/vector_db

# Knowledge Base Configuration
KNOWLEDGE_BASE_DIR=/var/lib/e-claw/knowledge
MAX_KNOWLEDGE_SIZE=10737418240

# Audit Configuration
AUDIT_LOG_RETENTION_DAYS=365

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key
LLM_BASE_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/e-claw/app.log