# AI Agent 模型管理系统 - 环境配置文件示例
# 复制此文件为 .env 并填入你的实际配置

# HuggingFace API配置
# 从 https://huggingface.co/settings/tokens 获取你的token
HUGGINGFACE_TOKEN=your_token_here

# HuggingFace缓存目录（可选）
# HUGGINGFACE_HOME=/path/to/cache

# 日志级别配置
LOG_LEVEL=INFO

# 模型存储目录（相对于项目根目录）
MODELS_DIR=./models

# 微调后的模型存储目录
FINETUNED_MODELS_DIR=./finetuned_models

# 日志目录
LOGS_DIR=./logs

# 默认部署端口
DEFAULT_DEPLOY_PORT=8000

# GPU配置
# 是否使用GPU
USE_GPU=true

# GPU设备ID（如果有多张GPU）
CUDA_VISIBLE_DEVICES=0

# 微调参数（可选，会覆盖默认值）
# 学习率
LEARNING_RATE=1e-4

# Batch大小
BATCH_SIZE=4

# 训练轮数
EPOCHS=3

# 最大序列长度
MAX_SEQ_LENGTH=2048

# 梯度堆积步数
GRADIENT_ACCUMULATION_STEPS=4

# 优化器
OPTIMIZER=adamw_8bit

# 是否使用bf16混合精度
USE_BF16=true

# 预热比例
WARMUP_RATIO=0.1

# 权重衰减
WEIGHT_DECAY=0.01

# 代理配置（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080
