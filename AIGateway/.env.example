# 复制为 .env 后填写；切勿提交真实密钥
LITELLM_MASTER_KEY=sk-change-me
UI_USERNAME=admin
UI_PASSWORD=sk-change-me
DATABASE_URL=postgresql://litellm:litellm@db:5432/litellm
STORE_MODEL_IN_DB=True

# 模型后端
OPENAI_KEY=
AZURE_OPENAI_BASE=
AZURE_OPENAI_KEY=
GEMINI_KEY=
OLLAMA_FAST_BASE=http://host.docker.internal:11434
OLLAMA_LOCAL_BASE=http://host.docker.internal:11434

# Guardrails SaaS / 云
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:5001
PRESIDIO_ANONYMIZER_URL=http://presidio-anonymizer:5002
LAKERA_KEY=
BEDROCK_GUARDRAIL_ID=
BEDROCK_REGION=us-east-1

# 可观测
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# 本地路径（容器内已默认）
GUARDRAIL_POLICY_PATH=/app/guardrails/policy.yaml
AUDIT_LOG_PATH=/var/log/ai-gateway/audit.jsonl
